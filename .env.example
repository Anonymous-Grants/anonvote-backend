# Copy to .env and fill in. See README.md for the full round-lifecycle walkthrough.

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anonvote
# BIND_ADDR=0.0.0.0:8080

# --- Soroban / Stellar ---
# The AnonVote contract's address (see anonvote-contracts). Must already be
# `initialize`d with a verifying key produced by the Noir circuit's trusted
# setup before this backend can create rounds.
ANONVOTE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# `stellar keys` identity alias (run `stellar keys generate operator --network
# testnet --fund` first) used as the transaction source/signer for every
# operator-signed call. This address becomes `round.admin` for rounds this
# backend creates, and pays the fees for relayed votes.
STELLAR_OPERATOR_IDENTITY=operator
# Identity used as the payment source in POST /payouts/execute. Defaults to
# STELLAR_OPERATOR_IDENTITY if unset — set this separately if your round's
# treasury is a different, better-funded account.
# STELLAR_TREASURY_IDENTITY=treasury

# Named network already configured in the `stellar` CLI (testnet | futurenet |
# mainnet | a custom name from `stellar network add`). Set this OR both
# STELLAR_RPC_URL and STELLAR_NETWORK_PASSPHRASE below.
STELLAR_NETWORK=testnet
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# STELLAR_CLI_PATH=stellar

# --- Noir circuit / proving ---
# Path to the circuit package (Nargo.toml + src/) in anonvote-contracts.
ANONVOTE_CIRCUIT_DIR=../anonvote-contracts/circuits/anonvote
# NARGO_PATH=nargo

# Path to a Barretenberg-compatible prover CLI. Leave unset to disable
# server-side proof generation (POST /votes will only accept an
# already-built `proof`, not a `witness`) — see README "casting a vote".
# BB_PATH=bb
# Override the exact `bb` invocation if your installed version's flags
# differ from this backend's default guess. {circuit}/{witness}/{out} are
# substituted with paths.
# BB_PROVE_ARGS=prove --scheme groth16 -b {circuit} -w {witness} -o {out}

RUST_LOG=anonvote_backend=info,tower_http=info
